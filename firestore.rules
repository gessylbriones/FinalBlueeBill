rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isProtectedAdmin(email) {
      return email is string
        && email.matches('(?i)^bluebillproject@gmail\\.com$');
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'createdAt'])
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'user'
        && request.resource.data.name is string;

      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['user', 'admin']
          && (
            !isProtectedAdmin(resource.data.email)
            || request.resource.data.role == 'admin'
          )
        ) || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'city'])
          && request.resource.data.name is string
          && request.resource.data.city is string
        );
      allow delete: if false;
    }

    match /bills/{billId} {
      allow read: if signedIn()
        && (isAdmin() || resource.data.email == request.auth.token.email);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /customers/{customerId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.email == request.auth.token.email);
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['id', 'customerNumber', 'name', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['id', 'customerNumber', 'name', 'email', 'createdAt'])
        && request.resource.data.id == customerId
        && request.resource.data.customerNumber == customerId
        && request.resource.data.name is string
        && request.resource.data.email is string;
      allow update: if (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'city', 'cycleStartReading', 'currentReading', 'cycleStartedAt', 'meterReadingUpdatedAt'
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['name'])
            || request.resource.data.name is string)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
            || request.resource.data.email is string)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['city'])
            || request.resource.data.city is string)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'cycleStartReading', 'currentReading', 'cycleStartedAt', 'meterReadingUpdatedAt'
          ]) || (
            request.resource.data.cycleStartReading is number
            && request.resource.data.cycleStartReading >= 0
            && request.resource.data.currentReading is number
            && request.resource.data.currentReading >= 0
            && request.resource.data.cycleStartedAt is string
            && request.resource.data.meterReadingUpdatedAt is string
          ))
        ) || (
          signedIn()
          && resource.data.email == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['city'])
          && request.resource.data.city is string
        );
      allow delete: if false;
    }
  }
}
